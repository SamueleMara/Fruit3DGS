      "mask_inst_dir": "samuele/datasets/multifruit_2026-02-19/mask_instances",
      "contrastive_objmasks": "masks"
    },
    {
      "name": "2022-09-06_scaled",
      "colmap_dir": "samuele/datasets/2022-09-06_scaled",
      "model_dir": "output/2022-09-06_scaled",
